<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Receipt Scanner — AI OCR</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #F5F0E8; --surface: #FDFAF4; --card: #FFFFFF;
  --accent: #C8522A; --accent2: #2A6B4F; --text: #1A1612;
  --muted: #8A7F72; --border: #DDD5C8; --tag-bg: #EDE8DF;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }

/* ── HEADER ── */
header {
  background: var(--text); color: var(--bg);
  padding: 14px 20px; display: flex; align-items: center;
  justify-content: space-between; position: sticky; top: 0; z-index: 100; gap: 10px;
}
.logo { display: flex; align-items: baseline; gap: 8px; }
.logo-title { font-family: 'Instrument Serif', serif; font-size: 20px; letter-spacing: .02em; }
.logo-tag { font-family: 'DM Mono', monospace; font-size: 9px; background: var(--accent); color: white; padding: 2px 6px; border-radius: 3px; letter-spacing: .05em; }
.header-actions { display: flex; gap: 8px; align-items: center; }

/* ── BUTTONS ── */
.btn { font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500; padding: 8px 16px; border-radius: 6px; border: none; cursor: pointer; transition: all 0.15s; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; }
.btn-accent { background: var(--accent); color: white; }
.btn-accent:hover { background: #b3471f; }
.btn-accent:disabled { background: #e0b8a8; cursor: not-allowed; }
.btn-green { background: var(--accent2); color: white; }
.btn-green:hover { background: #1f5a40; }
.btn-ghost { background: rgba(255,255,255,0.1); color: var(--bg); border: 1px solid rgba(255,255,255,0.2); }
.btn-ghost:hover { background: rgba(255,255,255,0.2); }
.btn-outline { background: none; border: 1.5px solid var(--border); color: var(--text); font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500; padding: 8px 16px; border-radius: 6px; cursor: pointer; transition: all 0.15s; }
.btn-outline:hover { background: var(--tag-bg); }
.btn-sm { font-size: 12px; padding: 6px 11px; }
.btn-xs { font-size: 11px; padding: 4px 8px; border-radius: 5px; }

/* ── LAYOUT ── */
.app-layout { display: grid; grid-template-columns: 400px 1fr; gap: 0; height: calc(100vh - 49px); }
.left-panel  { background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; overflow: hidden; }
.right-panel { display: flex; flex-direction: column; overflow: hidden; }

/* ── LEFT: UPLOAD ── */
.panel-header { padding: 16px 18px 12px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
.panel-title { font-family: 'DM Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }

.upload-area { flex: 1; display: flex; flex-direction: column; padding: 16px; gap: 12px; overflow-y: auto; }

.drop-zone {
  border: 2px dashed var(--border); border-radius: 12px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 10px; cursor: pointer; transition: all 0.2s; background: var(--bg);
  min-height: 200px; padding: 24px; text-align: center;
}
.drop-zone:hover, .drop-zone.drag-over { border-color: var(--accent); background: #fef6f3; }
.drop-zone .dz-icon { font-size: 36px; }
.drop-zone .dz-title { font-size: 14px; font-weight: 500; }
.drop-zone .dz-sub { font-size: 12px; color: var(--muted); line-height: 1.5; }

.preview-wrap { position: relative; border-radius: 10px; overflow: hidden; border: 1px solid var(--border); background: #000; }
.preview-wrap img { width: 100%; max-height: 340px; object-fit: contain; display: block; }
.preview-actions { position: absolute; top: 8px; right: 8px; display: flex; gap: 6px; }
.preview-pill { background: rgba(26,22,18,0.72); color: white; border: none; border-radius: 6px; padding: 5px 10px; font-size: 11px; font-family: 'DM Sans', sans-serif; cursor: pointer; backdrop-filter: blur(4px); }
.preview-pill:hover { background: rgba(26,22,18,0.88); }

.scan-btn-wrap { display: flex; gap: 8px; }

/* ── STATUS BAR ── */
.status-bar { padding: 10px 18px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; font-size: 12px; min-height: 42px; background: var(--surface); }
.status-idle     { color: var(--muted); }
.status-scanning { color: var(--accent); }
.status-done     { color: var(--accent2); }
.status-error    { color: #dc2626; }
.spinner { width: 14px; height: 14px; border: 2px solid #f5ccc0; border-top-color: var(--accent); border-radius: 50%; animation: spin 0.7s linear infinite; flex-shrink: 0; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ── RESULTS ── */
.results-area { flex: 1; overflow-y: auto; padding: 0; }
.results-table-wrap { overflow-x: auto; }
.results-table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 520px; }
.results-table th { text-align: left; font-family: 'DM Mono', monospace; font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding: 10px 10px 8px; border-bottom: 1px solid var(--border); background: var(--surface); position: sticky; top: 0; }
.results-table th:last-child { text-align: right; }
.results-table td { padding: 7px 8px; vertical-align: middle; border-bottom: 1px solid #f0ebe3; }
.results-table tbody tr:hover td { background: #fdfaf4; }
.results-table tbody tr.row-excluded td { opacity: 0.38; }

/* inline inputs */
.cell-input { border: 1px solid transparent; background: transparent; font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--text); padding: 3px 5px; border-radius: 4px; width: 100%; transition: all 0.15s; }
.cell-input:focus { outline: none; border-color: var(--border); background: var(--bg); }
.cell-input.mono { font-family: 'DM Mono', monospace; text-align: right; }
.cell-input.qty  { font-family: 'DM Mono', monospace; text-align: center; width: 52px; }

/* status chips */
.status-chip { display: inline-flex; align-items: center; font-family: 'DM Mono', monospace; font-size: 9px; font-weight: 500; padding: 3px 8px; border-radius: 4px; cursor: pointer; border: 1.5px solid var(--border); background: white; transition: all 0.12s; white-space: nowrap; }
.chip-used     { border-color: var(--accent2); background: #f0fdf4; color: var(--accent2); }
.chip-returned { border-color: #d97706; background: #fffbeb; color: #d97706; }
.chip-kept     { border-color: var(--muted); background: var(--tag-bg); color: var(--muted); }

/* confidence dot */
.conf-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
.conf-high { background: var(--accent2); }
.conf-low  { background: #f59e0b; }

/* del button */
.btn-row-del { background: none; border: none; color: #ccc; cursor: pointer; font-size: 16px; padding: 2px 4px; border-radius: 4px; }
.btn-row-del:hover { color: var(--accent); background: #fef0eb; }

/* ── FOOTER / TOTALS ── */
.results-footer { padding: 14px 18px; border-top: 1px solid var(--border); background: var(--surface); display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; flex-shrink: 0; }
.totals-group { display: flex; gap: 20px; flex-wrap: wrap; }
.total-item { text-align: right; }
.total-label { font-family: 'DM Mono', monospace; font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 2px; }
.total-value { font-family: 'DM Mono', monospace; font-size: 16px; font-weight: 500; }
.total-value.green { color: var(--accent2); }
.footer-actions { display: flex; gap: 8px; flex-wrap: wrap; }

/* ── EMPTY STATE ── */
.empty-results { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: 10px; color: var(--muted); padding: 48px 24px; text-align: center; }
.empty-results .icon { font-size: 40px; }
.empty-results h3 { font-family: 'Instrument Serif', serif; font-size: 18px; color: var(--text); font-weight: 400; }
.empty-results p { font-size: 13px; line-height: 1.6; }

/* ── API KEY BANNER ── */
.api-banner { background: #fef3c7; border-bottom: 1px solid #fde68a; padding: 10px 20px; display: flex; align-items: center; gap: 10px; font-size: 13px; color: #92400e; flex-wrap: wrap; }
.api-banner a { color: var(--accent); font-weight: 500; cursor: pointer; }

/* ── SETTINGS PANEL ── */
.settings-overlay { display: none; position: fixed; inset: 0; background: rgba(26,22,18,0.4); z-index: 300; }
.settings-overlay.open { display: block; }
.settings-panel { position: fixed; right: 0; top: 0; bottom: 0; width: 320px; background: var(--card); border-left: 1px solid var(--border); padding: 24px; overflow-y: auto; z-index: 301; box-shadow: -4px 0 24px rgba(0,0,0,0.1); animation: slideIn 0.2s ease; }
@keyframes slideIn { from { transform: translateX(40px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
.settings-title { font-family: 'Instrument Serif', serif; font-size: 20px; font-weight: 400; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; }
.settings-close { background: none; border: none; font-size: 22px; cursor: pointer; color: var(--muted); line-height: 1; }
.settings-section { margin-bottom: 22px; }
.settings-section h3 { font-family: 'DM Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 12px; padding-bottom: 7px; border-bottom: 1px solid var(--border); }
.field { margin-bottom: 12px; }
.field label { display: block; font-size: 11px; font-weight: 500; color: var(--muted); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.06em; font-family: 'DM Mono', monospace; }
.field input, .field select { width: 100%; border: 1.5px solid var(--border); border-radius: 8px; padding: 9px 11px; font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--text); background: var(--bg); -webkit-appearance: none; transition: border-color 0.15s; }
.field input:focus, .field select:focus { outline: none; border-color: var(--accent); }
.info-box { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 12px 14px; font-size: 12px; color: #1e40af; line-height: 1.6; }

/* ── EXPORT MODAL ── */
.modal-overlay { display: none; position: fixed; inset: 0; background: rgba(26,22,18,0.55); z-index: 400; align-items: flex-end; justify-content: center; }
.modal-overlay.open { display: flex; }
.modal { background: var(--card); border-radius: 18px 18px 0 0; padding: 26px 22px 34px; width: 100%; max-width: 500px; box-shadow: 0 -8px 40px rgba(0,0,0,0.18); animation: slideUp 0.22s ease; }
@keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.modal-handle { width: 40px; height: 4px; background: var(--border); border-radius: 2px; margin: 0 auto 18px; }
.modal h2 { font-family: 'Instrument Serif', serif; font-size: 20px; font-weight: 400; margin-bottom: 14px; }
.modal textarea { width: 100%; border: 1.5px solid var(--border); border-radius: 8px; padding: 10px 12px; font-family: 'DM Mono', monospace; font-size: 12px; color: var(--text); background: var(--bg); min-height: 200px; resize: vertical; }
.modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 14px; flex-wrap: wrap; }

/* ── SCROLLBAR ── */
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

/* ── MOBILE ── */
@media (max-width: 720px) {
  .app-layout { grid-template-columns: 1fr; height: auto; }
  .left-panel  { border-right: none; border-bottom: 1px solid var(--border); height: auto; }
  .drop-zone { min-height: 140px; }
  .right-panel { height: calc(100vh - 49px - 300px); min-height: 400px; }
  .settings-panel { width: 100%; }
}
</style>
</head>
<body>

<!-- ── API KEY BANNER (shown when no key set) ── -->
<div id="api-banner" class="api-banner" style="display:none">
  ⚠️ No API key set. <a onclick="openSettings()">Click here to add your Anthropic API key</a> — scanning requires it.
</div>

<header>
  <div class="logo">
    <span class="logo-title">Receipt Scanner</span>
    <span class="logo-tag">AI OCR</span>
  </div>
  <div class="header-actions">
    <button class="btn btn-ghost btn-sm" onclick="openSettings()">⚙ Settings</button>
  </div>
</header>

<div class="app-layout">

  <!-- ── LEFT PANEL: UPLOAD ── -->
  <div class="left-panel">
    <div class="panel-header">
      <span class="panel-title">Receipt Photo</span>
      <span id="img-size-label" style="font-size:10px;color:var(--muted);font-family:'DM Mono',monospace"></span>
    </div>

    <div class="upload-area">

      <!-- Drop zone (shown when no image) -->
      <div id="drop-zone" class="drop-zone"
           onclick="document.getElementById('file-input').click()"
           ondragover="onDragOver(event)" ondragleave="onDragLeave(event)" ondrop="onDrop(event)">
        <div class="dz-icon">📷</div>
        <div class="dz-title">Take or upload a receipt photo</div>
        <div class="dz-sub">Drag & drop, click to browse,<br>or use camera on mobile</div>
        <button class="btn btn-accent btn-sm" style="margin-top:4px" onclick="event.stopPropagation();document.getElementById('file-input').click()">Choose Photo</button>
      </div>

      <!-- Image preview (shown after upload) -->
      <div id="preview-wrap" class="preview-wrap" style="display:none">
        <img id="preview-img" src="" alt="receipt">
        <div class="preview-actions">
          <button class="preview-pill" onclick="document.getElementById('file-input').click()">↺ Change</button>
          <button class="preview-pill" onclick="clearImage()">✕ Remove</button>
        </div>
      </div>

      <!-- Scan button -->
      <div id="scan-btn-wrap" class="scan-btn-wrap" style="display:none">
        <button class="btn btn-accent" style="flex:1;justify-content:center;padding:11px" id="scan-btn" onclick="scanReceipt()">
          ✦ Scan with AI
        </button>
        <button class="btn btn-outline btn-sm" onclick="addItemManually()" title="Add item manually">+ Item</button>
      </div>

      <!-- Tips -->
      <div id="scan-tips" style="font-size:11px;color:var(--muted);line-height:1.7;padding:4px 2px;display:none">
        <strong style="color:var(--text)">Tips for best results:</strong><br>
        • Lay receipt flat, good lighting<br>
        • Capture full receipt including total<br>
        • Avoid shadows and blur
      </div>

    </div>
  </div>

  <!-- ── RIGHT PANEL: RESULTS ── -->
  <div class="right-panel">

    <!-- Status bar -->
    <div class="status-bar" id="status-bar">
      <span class="status-idle" id="status-text">Upload a receipt photo to get started</span>
    </div>

    <!-- Results / empty state -->
    <div class="results-area" id="results-area">
      <div class="empty-results" id="empty-results">
        <div class="icon">🧾</div>
        <h3>No items yet</h3>
        <p>Upload a receipt photo and click<br><strong>Scan with AI</strong> to automatically extract all items</p>
      </div>
      <div id="results-table-container" style="display:none">
        <div class="results-table-wrap">
          <table class="results-table" id="results-table">
            <thead>
              <tr>
                <th style="width:28px">✓</th>
                <th>Item Description</th>
                <th style="width:52px;text-align:center">Qty</th>
                <th style="width:90px;text-align:right">Unit $</th>
                <th style="width:90px;text-align:right">Total $</th>
                <th style="width:90px">Status</th>
                <th style="width:28px"></th>
              </tr>
            </thead>
            <tbody id="items-tbody"></tbody>
          </table>
        </div>
        <div style="padding:10px 14px">
          <button class="btn btn-outline btn-sm" onclick="addItemManually()">+ Add Item Manually</button>
        </div>
      </div>
    </div>

    <!-- Footer totals -->
    <div class="results-footer" id="results-footer" style="display:none">
      <div class="totals-group">
        <div class="total-item">
          <div class="total-label">Total on Receipt</div>
          <div class="total-value" id="total-all">$0.00</div>
        </div>
        <div class="total-item">
          <div class="total-label">Billable (Used)</div>
          <div class="total-value green" id="total-billable">$0.00</div>
        </div>
        <div class="total-item">
          <div class="total-label">Items</div>
          <div class="total-value" id="total-count" style="font-size:14px">0</div>
        </div>
      </div>
      <div class="footer-actions">
        <button class="btn btn-outline btn-sm" onclick="openExport()">📋 Export</button>
        <button class="btn btn-green btn-sm" onclick="openExport()">Copy / Print</button>
        <button class="btn btn-outline btn-sm" onclick="clearAll()" style="color:var(--muted)">Clear</button>
      </div>
    </div>

  </div>
</div>

<!-- Hidden file input -->
<input type="file" id="file-input" accept="image/*" capture="environment" style="display:none" onchange="handleFileSelect(event)">

<!-- ── SETTINGS PANEL ── -->
<div class="settings-overlay" id="settings-overlay" onclick="closeSettings()"></div>
<div class="settings-panel" id="settings-panel" style="display:none">
  <div class="settings-title">
    Settings
    <button class="settings-close" onclick="closeSettings()">✕</button>
  </div>

  <div class="settings-section">
    <h3>Anthropic API Key</h3>
    <div class="info-box" style="margin-bottom:12px">
      Get your free API key at <strong>console.anthropic.com</strong><br>
      The key is stored only in your browser (localStorage).<br>
      Never share this file with your key inside it.
    </div>
    <div class="field">
      <label>API Key</label>
      <input type="password" id="set-api-key" placeholder="sk-ant-...">
    </div>
    <div style="display:flex;gap:8px;align-items:center">
      <button class="btn btn-accent btn-sm" onclick="saveSettings()">Save Key</button>
      <span id="key-saved-msg" style="display:none;font-size:12px;color:var(--accent2)">✓ Saved</span>
    </div>
  </div>

  <div class="settings-section">
    <h3>AI Model</h3>
    <div class="field">
      <label>Model</label>
      <select id="set-model">
        <option value="claude-opus-4-5">claude-opus-4-5 (most accurate)</option>
        <option value="claude-sonnet-4-5" selected>claude-sonnet-4-5 (faster)</option>
        <option value="claude-haiku-4-5">claude-haiku-4-5 (cheapest)</option>
      </select>
    </div>
    <div class="field">
      <label>Language hint</label>
      <select id="set-lang">
        <option value="">Auto-detect</option>
        <option value="en">English</option>
        <option value="es">Spanish</option>
        <option value="zh">Chinese</option>
      </select>
    </div>
  </div>

  <div class="settings-section">
    <h3>Default Item Status</h3>
    <div class="field">
      <label>New items default to</label>
      <select id="set-default-status">
        <option value="used">✓ Used (Billable)</option>
        <option value="returned">↩ Returned</option>
        <option value="kept">📦 Kept / Other Job</option>
      </select>
    </div>
  </div>

  <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border)">
    <button class="btn btn-outline" style="width:100%;color:#dc2626;border-color:#fecaca" onclick="clearStoredKey()">Remove Stored API Key</button>
  </div>
</div>

<!-- ── EXPORT MODAL ── -->
<div class="modal-overlay" id="modal-export">
  <div class="modal" style="max-width:560px">
    <div class="modal-handle"></div>
    <h2>Export Items</h2>
    <textarea id="export-text" readonly onclick="this.select()"></textarea>
    <div class="modal-actions">
      <button class="btn-outline" onclick="closeModal('modal-export')" style="background:none;border:1.5px solid var(--border);padding:8px 14px;border-radius:6px;cursor:pointer;font-size:13px">Close</button>
      <button class="btn btn-outline btn-sm" onclick="copyExport()">📋 Copy</button>
      <button class="btn btn-accent btn-sm" onclick="printExport()">🖨 Print</button>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════
let imageDataUrl = null;
let items = [];       // [{id, name, qty, unitPrice, total, status, confidence}]
let scanning = false;
let rowSeq = 0;

const CFG_KEY = 'receiptScannerConfig';

function loadConfig() {
  try { return JSON.parse(localStorage.getItem(CFG_KEY) || '{}'); } catch(e) { return {}; }
}
function saveConfig(patch) {
  const c = { ...loadConfig(), ...patch };
  localStorage.setItem(CFG_KEY, JSON.stringify(c));
}

function getApiKey()        { return loadConfig().apiKey || ''; }
function getModel()         { return loadConfig().model || 'claude-sonnet-4-5'; }
function getDefaultStatus() { return loadConfig().defaultStatus || 'used'; }
function getLang()          { return loadConfig().lang || ''; }

function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2,5); }
function fmt$(n) { return '$' + (parseFloat(n)||0).toFixed(2); }

// ═══════════════════════════════════════════
//  IMAGE HANDLING
// ═══════════════════════════════════════════
function handleFileSelect(e) {
  const file = e.target.files[0];
  if (!file) return;
  loadImage(file);
  e.target.value = '';
}

function onDragOver(e) {
  e.preventDefault();
  document.getElementById('drop-zone').classList.add('drag-over');
}
function onDragLeave(e) {
  document.getElementById('drop-zone').classList.remove('drag-over');
}
function onDrop(e) {
  e.preventDefault();
  document.getElementById('drop-zone').classList.remove('drag-over');
  const file = e.dataTransfer.files[0];
  if (file && file.type.startsWith('image/')) loadImage(file);
}

function loadImage(file) {
  const reader = new FileReader();
  reader.onload = ev => {
    const img = new Image();
    img.onload = () => {
      // compress to max 1600px
      const canvas = document.createElement('canvas');
      const MAX = 1600;
      let [w, h] = [img.width, img.height];
      if (w > MAX || h > MAX) {
        if (w > h) { h = Math.round(h * MAX / w); w = MAX; }
        else       { w = Math.round(w * MAX / h); h = MAX; }
      }
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(img, 0, 0, w, h);
      imageDataUrl = canvas.toDataURL('image/jpeg', 0.88);

      // show preview
      document.getElementById('preview-img').src = imageDataUrl;
      document.getElementById('drop-zone').style.display   = 'none';
      document.getElementById('preview-wrap').style.display = '';
      document.getElementById('scan-btn-wrap').style.display = '';
      document.getElementById('scan-tips').style.display = '';

      // show image size
      const kb = Math.round(imageDataUrl.length * 0.75 / 1024);
      document.getElementById('img-size-label').textContent = `${w}×${h} · ${kb}KB`;

      setStatus('idle', `Photo ready — click "Scan with AI" to extract items`);
      checkApiKey();
    };
    img.src = ev.target.result;
  };
  reader.readAsDataURL(file);
}

function clearImage() {
  imageDataUrl = null;
  document.getElementById('preview-img').src = '';
  document.getElementById('preview-wrap').style.display = 'none';
  document.getElementById('drop-zone').style.display = '';
  document.getElementById('scan-btn-wrap').style.display = 'none';
  document.getElementById('scan-tips').style.display = 'none';
  document.getElementById('img-size-label').textContent = '';
  setStatus('idle', 'Upload a receipt photo to get started');
}

function clearAll() {
  clearImage();
  items = [];
  renderTable();
}

// ═══════════════════════════════════════════
//  STATUS
// ═══════════════════════════════════════════
function setStatus(type, msg, showSpinner) {
  const bar = document.getElementById('status-bar');
  bar.innerHTML = '';
  if (showSpinner) {
    const sp = document.createElement('div'); sp.className = 'spinner'; bar.appendChild(sp);
  }
  const txt = document.createElement('span');
  txt.className = `status-${type}`;
  txt.textContent = msg;
  bar.appendChild(txt);
}

// ═══════════════════════════════════════════
//  AI SCAN
// ═══════════════════════════════════════════
async function scanReceipt() {
  if (!imageDataUrl) { alert('Please upload a photo first.'); return; }
  if (scanning) return;

  const apiKey = getApiKey();
  if (!apiKey) { openSettings(); return; }

  scanning = true;
  document.getElementById('scan-btn').disabled = true;
  document.getElementById('scan-btn').textContent = 'Scanning…';
  setStatus('scanning', 'AI is reading the receipt…', true);

  try {
    const base64 = imageDataUrl.split(',')[1];
    const mediaType = imageDataUrl.split(';')[0].split(':')[1] || 'image/jpeg';
    const lang = getLang();
    const langHint = lang ? ` (receipt may be in ${lang})` : '';

    const prompt = `You are a receipt OCR expert. Analyze this store receipt image${langHint} and extract every purchased line item with maximum accuracy.

Return ONLY a valid JSON array — no markdown fences, no explanation, no extra text.
Format: [{"name":"item description","qty":1,"unit_price":9.99,"total":9.99,"confidence":"high"}]

Rules:
- name: clean product description, remove SKU codes but keep brand/size if visible
- unit_price: price per single unit as a decimal number (no $ symbol)
- qty: quantity as integer, default 1 if not shown
- total: qty × unit_price as decimal number
- confidence: "high" if clearly readable, "low" if uncertain or partially visible
- Include tax lines (label them "Tax" or "Sales Tax") as separate items
- Include any fees, discounts (negative amount), or deposits
- If a discount applies to an item, reflect it in the item price
- Do NOT include subtotal or grand total lines — items only
- If the receipt is unreadable or not a receipt, return []`;

    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01',
        'anthropic-dangerous-direct-browser-access': 'true'
      },
      body: JSON.stringify({
        model: getModel(),
        max_tokens: 2000,
        messages: [{
          role: 'user',
          content: [
            { type: 'image', source: { type: 'base64', media_type: mediaType, data: base64 } },
            { type: 'text', text: prompt }
          ]
        }]
      })
    });

    const rawText = await response.text();
    let data;
    try { data = JSON.parse(rawText); }
    catch(e) { throw new Error('Unexpected response format'); }

    if (!response.ok || data.type === 'error') {
      throw new Error(data?.error?.message || `API error ${response.status}`);
    }

    // extract text from response
    const aiText = (data.content || []).filter(c => c.type === 'text').map(c => c.text).join('');

    // parse JSON from AI text
    let extracted = [];
    try {
      const clean = aiText.replace(/```json|```/gi, '').trim();
      const match = clean.match(/\[[\s\S]*\]/);
      if (match) extracted = JSON.parse(match[0]);
    } catch(e) {
      throw new Error('Could not parse AI response. Try again or add items manually.');
    }

    if (!Array.isArray(extracted) || extracted.length === 0) {
      setStatus('error', '⚠ No items found. Receipt may be unclear — try again or add items manually.');
      return;
    }

    // convert to our item format
    const defaultStatus = getDefaultStatus();
    items = extracted.map(i => ({
      id: uid(),
      name:       String(i.name || 'Item').slice(0, 100),
      qty:        Math.max(1, parseInt(i.qty) || 1),
      unitPrice:  parseFloat(i.unit_price) || 0,
      total:      parseFloat(i.total) || (parseFloat(i.unit_price) || 0) * (parseInt(i.qty) || 1),
      status:     defaultStatus,
      confidence: i.confidence === 'low' ? 'low' : 'high'
    }));

    renderTable();
    setStatus('done', `✓ Extracted ${items.length} item${items.length!==1?'s':''} — review and adjust as needed`);

  } catch(err) {
    console.error('[Scan]', err);
    setStatus('error', `⚠ ${err.message}`);
    if (!items.length) renderTable(); // show empty state with manual add option
  } finally {
    scanning = false;
    const btn = document.getElementById('scan-btn');
    btn.disabled = false;
    btn.innerHTML = '↺ Re-scan';
  }
}

// ═══════════════════════════════════════════
//  TABLE RENDER
// ═══════════════════════════════════════════
function renderTable() {
  const tbody = document.getElementById('items-tbody');
  const container = document.getElementById('results-table-container');
  const empty = document.getElementById('empty-results');
  const footer = document.getElementById('results-footer');

  if (!items.length) {
    container.style.display = 'none';
    empty.style.display = '';
    footer.style.display = 'none';
    return;
  }

  empty.style.display = 'none';
  container.style.display = '';
  footer.style.display = '';

  tbody.innerHTML = items.map(item => {
    const excluded = item.status !== 'used';
    const chipClass = { used: 'chip-used', returned: 'chip-returned', kept: 'chip-kept' }[item.status] || '';
    const chipLabel = { used: '✓ Used', returned: '↩ Return', kept: '📦 Kept' }[item.status] || item.status;
    const nextStatus = { used: 'returned', returned: 'kept', kept: 'used' };
    return `
    <tr id="row-${item.id}" class="${excluded ? 'row-excluded' : ''}">
      <td style="text-align:center">
        <input type="checkbox" ${!excluded?'checked':''} style="accent-color:var(--accent2);width:15px;height:15px;cursor:pointer"
               onchange="toggleUsed('${item.id}',this.checked)">
      </td>
      <td>
        <div style="display:flex;align-items:center;gap:5px">
          ${item.confidence==='low' ? `<span class="conf-dot conf-low" title="Low confidence — verify price"></span>` : ''}
          <input class="cell-input" value="${escAttr(item.name)}" onchange="updateItem('${item.id}','name',this.value)"
                 style="min-width:120px">
        </div>
      </td>
      <td>
        <input class="cell-input qty" type="number" value="${item.qty}" min="0.01" step="any"
               onchange="updateItem('${item.id}','qty',this.value)">
      </td>
      <td>
        <input class="cell-input mono" type="number" value="${item.unitPrice.toFixed(2)}" step="0.01" min="0"
               onchange="updateItem('${item.id}','unitPrice',this.value)">
      </td>
      <td>
        <input class="cell-input mono" type="number" value="${item.total.toFixed(2)}" step="0.01"
               onchange="updateItem('${item.id}','total',this.value)">
      </td>
      <td>
        <span class="status-chip ${chipClass}" onclick="cycleStatus('${item.id}','${nextStatus[item.status]}')"
              title="Click to change status">
          ${chipLabel}
        </span>
      </td>
      <td>
        <button class="btn-row-del" onclick="deleteItem('${item.id}')" title="Delete row">✕</button>
      </td>
    </tr>`;
  }).join('');

  updateTotals();
}

function updateTotals() {
  const totalAll      = items.reduce((s,i) => s + i.total, 0);
  const totalBillable = items.filter(i => i.status === 'used').reduce((s,i) => s + i.total, 0);
  document.getElementById('total-all').textContent      = fmt$(totalAll);
  document.getElementById('total-billable').textContent = fmt$(totalBillable);
  document.getElementById('total-count').textContent    = items.length;
}

function escAttr(s) {
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ═══════════════════════════════════════════
//  ITEM ACTIONS
// ═══════════════════════════════════════════
function updateItem(id, field, val) {
  const item = items.find(i => i.id === id);
  if (!item) return;
  if (field === 'name')      { item.name = val; }
  else if (field === 'qty')  { item.qty = parseFloat(val) || 1; item.total = +(item.qty * item.unitPrice).toFixed(2); }
  else if (field === 'unitPrice') { item.unitPrice = parseFloat(val) || 0; item.total = +(item.qty * item.unitPrice).toFixed(2); }
  else if (field === 'total') { item.total = parseFloat(val) || 0; if (item.qty > 0) item.unitPrice = +(item.total / item.qty).toFixed(2); }
  // refresh total cell only
  const row = document.getElementById('row-' + id);
  if (row && field !== 'total' && field !== 'name') {
    const inputs = row.querySelectorAll('.cell-input');
    if (inputs[2]) inputs[2].value = item.total.toFixed(2); // total col
    if (inputs[1]) inputs[1].value = item.unitPrice.toFixed(2); // unit col
  }
  updateTotals();
}

function toggleUsed(id, checked) {
  const item = items.find(i => i.id === id);
  if (!item) return;
  item.status = checked ? 'used' : 'kept';
  renderTable();
}

function cycleStatus(id, newStatus) {
  const item = items.find(i => i.id === id);
  if (!item) return;
  item.status = newStatus;
  renderTable();
}

function deleteItem(id) {
  items = items.filter(i => i.id !== id);
  renderTable();
}

function addItemManually() {
  items.push({ id: uid(), name: '', qty: 1, unitPrice: 0, total: 0, status: getDefaultStatus(), confidence: 'high' });
  renderTable();
  // focus last name input
  setTimeout(() => {
    const inputs = document.querySelectorAll('#items-tbody .cell-input');
    if (inputs.length) inputs[inputs.length - 3].focus();
  }, 50);
}

// ═══════════════════════════════════════════
//  EXPORT
// ═══════════════════════════════════════════
function openExport() {
  let txt = 'RECEIPT ITEMS\n';
  txt += '='.repeat(60) + '\n';
  txt += `Date: ${new Date().toLocaleDateString()}\n\n`;
  txt += 'ITEM                           QTY   UNIT $   TOTAL $   STATUS\n';
  txt += '-'.repeat(68) + '\n';

  items.forEach(i => {
    const name  = i.name.slice(0,30).padEnd(30);
    const qty   = String(i.qty).padStart(4);
    const unit  = fmt$(i.unitPrice).padStart(8);
    const total = fmt$(i.total).padStart(9);
    const status = { used: 'Billable', returned: 'Returned', kept: 'Kept' }[i.status] || i.status;
    txt += `${name} ${qty} ${unit} ${total}   ${status}\n`;
  });

  txt += '-'.repeat(68) + '\n';
  const totalAll      = items.reduce((s,i) => s + i.total, 0);
  const totalBillable = items.filter(i => i.status === 'used').reduce((s,i) => s + i.total, 0);
  txt += `${'TOTAL'.padEnd(46)}${fmt$(totalAll).padStart(9)}\n`;
  txt += `${'BILLABLE (USED ITEMS)'.padEnd(46)}${fmt$(totalBillable).padStart(9)}\n`;

  document.getElementById('export-text').value = txt;
  openModal('modal-export');
}

function copyExport() {
  const txt = document.getElementById('export-text').value;
  navigator.clipboard.writeText(txt).then(() => {
    const btn = event.target;
    btn.textContent = '✓ Copied!';
    setTimeout(() => btn.textContent = '📋 Copy', 2000);
  });
}

function printExport() {
  const txt = document.getElementById('export-text').value;
  const w = window.open('','_blank');
  w.document.write(`<html><head><title>Receipt Items</title>
    <style>body{font-family:'Courier New',monospace;padding:32px;font-size:13px;white-space:pre;color:#1A1612}@media print{body{padding:16px}}</style>
    </head><body>${txt.replace(/</g,'&lt;')}</body></html>`);
  w.document.close(); w.print();
}

// ═══════════════════════════════════════════
//  SETTINGS
// ═══════════════════════════════════════════
function openSettings() {
  const cfg = loadConfig();
  document.getElementById('set-api-key').value = cfg.apiKey ? '•'.repeat(20) : '';
  document.getElementById('set-model').value = cfg.model || 'claude-sonnet-4-5';
  document.getElementById('set-default-status').value = cfg.defaultStatus || 'used';
  document.getElementById('set-lang').value = cfg.lang || '';
  document.getElementById('settings-panel').style.display = '';
  document.getElementById('settings-overlay').classList.add('open');
  document.getElementById('key-saved-msg').style.display = 'none';
}

function closeSettings() {
  document.getElementById('settings-panel').style.display = 'none';
  document.getElementById('settings-overlay').classList.remove('open');
}

function saveSettings() {
  const keyInput = document.getElementById('set-api-key').value.trim();
  const patch = {
    model:         document.getElementById('set-model').value,
    defaultStatus: document.getElementById('set-default-status').value,
    lang:          document.getElementById('set-lang').value,
  };
  // only update key if user typed something new (not the bullet placeholder)
  if (keyInput && !keyInput.startsWith('•')) {
    patch.apiKey = keyInput;
  }
  saveConfig(patch);
  document.getElementById('key-saved-msg').style.display = 'inline';
  checkApiKey();
}

function clearStoredKey() {
  saveConfig({ apiKey: '' });
  document.getElementById('set-api-key').value = '';
  checkApiKey();
  closeSettings();
}

function checkApiKey() {
  const banner = document.getElementById('api-banner');
  banner.style.display = getApiKey() ? 'none' : '';
}

// ═══════════════════════════════════════════
//  MODAL HELPERS
// ═══════════════════════════════════════════
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(m =>
  m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open'); })
);
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    closeSettings();
    document.querySelectorAll('.modal-overlay.open').forEach(m => m.classList.remove('open'));
  }
});

// ═══════════════════════════════════════════
//  INIT
// ═══════════════════════════════════════════
checkApiKey();
</script>
</body>
</html>
